# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed origins for CORS (e.g. your Next.js app)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL (via DATABASE_URL for Prisma)
# ---------------------------------------------------------------------------
# Use DATABASE_URL for Prisma ORM
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace_db"

# Legacy TypeORM env vars (kept for reference, can be deprecated)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=marketplace_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Seed - bootstrap admin account (used by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@business-dev.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULLNAME=Super Admin

# ---------------------------------------------------------------------------
# Rate limiting (requests / ttl in ms)
# ---------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
